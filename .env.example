# VSpicy frontend local environment example
# Copy to .env.local and adjust locally. Do not commit .env.local.

VITE_APP_NAME=VSpicy
VITE_API_BASE_URL=http://localhost:18080
VITE_VIDEO_API_BASE_URL=http://localhost:18084
VITE_AUTH_API_BASE_URL=http://localhost:18082
VITE_ADMIN_API_BASE_URL=http://localhost:18090
VITE_NOTIFICATION_API_BASE_URL=http://localhost:18091
VITE_ENABLE_MOCK=false
VITE_ENABLE_DEV_TOOLS=true
